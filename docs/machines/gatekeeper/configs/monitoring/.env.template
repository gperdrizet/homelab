# Environment file for the gatekeeper monitoring stack (docker-compose.monitoring.yml).
# Deployed on gatekeeper as /srv/infra/.env (chmod 600). NOT committed - copy this
# template there and fill in real values. Vaultwarden backup is planned, not yet in place,
# so the on-host /srv/infra/.env is currently the only copy - back it up manually.

# Grafana admin login password (username is "admin"). Compose falls back to "admin" if unset,
# so always set this. Note: this value only takes effect on a fresh grafana.db. To change the
# password on an existing install, reset it directly instead:
#   docker exec -i monitoring-grafana grafana cli admin reset-admin-password --password-from-stdin
GRAFANA_ADMIN_PASSWORD=

# SMTP for Grafana alert emails. GF_SMTP_HOST is hardcoded to smtp.gmail.com:587 in the compose.
# For Gmail: SMTP_USER is the sending address and SMTP_PASSWORD is a Google App Password
# (not the account password). SMTP_FROM is the visible From address.
# Leave these blank to disable email alerting (also set GF_SMTP_ENABLED=false in the compose,
# otherwise Grafana attempts and fails to send).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
