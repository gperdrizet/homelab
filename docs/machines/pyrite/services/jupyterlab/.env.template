# Copy this file to .env before deploying on pyrite.

# Curated image from the docker-images repo.
JUPYTER_IMAGE=gperdrizet/datascience-nvidia:6.0.1

# Tailnet exposure.
TAILNET_IP=100.64.0.2
JUPYTER_PORT=47302

# Set this to a real Jupyter password hash before deployment.
# Example generation command inside a suitable Python/Jupyter environment:
#   python -c "from jupyter_server.auth import passwd; print(passwd())"
# Keep the hash single-quoted so docker compose preserves the literal '$' characters.
JUPYTER_PASSWORD_HASH='CHANGE_ME'

# Host paths.
JUPYTER_CONFIG_DIR=/opt/jupyterlab/config
HOST_HOME_DIR=/home/siderealyear

# GPU access.
# On pyrite, GPU index 0 is the GTX 1070. The two Tesla P100s (indices 1, 2)
# are reserved for LLM inference and are not passed to this container.
NVIDIA_VISIBLE_DEVICES=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Container locale/time.
TZ=America/New_York
